from pyspark.sql.functions import count

silver_df = spark.read.format("delta").load(
    "Tables/silver_posts"
)

gold_df = silver_df.groupBy("userId").agg(
    count("*").alias("total_posts")
)

gold_df.write \
    .mode("overwrite") \
    .format("delta") \
    .save("Tables/gold_user_post_summary")
