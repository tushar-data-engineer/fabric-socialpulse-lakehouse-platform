from pyspark.sql import SparkSession

spark = SparkSession.builder.getOrCreate()

bronze_df = spark.read.json(
    "Files/API_data/bronze/posts/Raw_API_DATA.json"
)

clean_df = (
    bronze_df
    .dropDuplicates()
    .filter(bronze_df.userId.isNotNull())
)

clean_df.write \
    .mode("overwrite") \
    .format("delta") \
    .save("Tables/silver_posts")
